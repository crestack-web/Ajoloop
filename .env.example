# Online backend (any of these name pairs work on Vercel)
# Preferred:
VITE_API_MODE=remote
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Also accepted (what you may already have on Vercel):
# SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_public_key

# Bachs payments (server-only — set on Vercel, never VITE_)
# BATCHS_API_KEY=sk_live_... or sk_sandbox_...  (also accepts BACHS_API_KEY)
# BACHS_WEBHOOK_SECRET=whsec_...   (optional)
# SUPABASE_SERVICE_ROLE_KEY=...    (required for webhooks to credit wallets)
# APP_URL=https://your-app.vercel.app
